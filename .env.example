# LLM Configuration (Free tier default: Google AI Studio Gemini Flash)
# Options for LLM_PROVIDER: gemini | groq | openrouter
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Google AI Studio API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Fallback LLM API Keys (Optional)
# Groq Cloud (https://console.groq.com/keys) - e.g. llama-3.3-70b-versatile
GROQ_API_KEY=
# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Search API Key (https://app.tavily.com/home)
# Optional: If empty or quota exceeded, pipeline automatically falls back to DuckDuckGo (ddgs)
TAVILY_API_KEY=

# Runtime limits
MAX_LIVE_RUNS_PER_SESSION=5
